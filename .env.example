# API configuration
API_V1_STR=/api/v1
PROJECT_NAME=AI General Chatbot
BACKEND_CORS_ORIGINS=["*"]

# Security configuration
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# Database configuration
SQLALCHEMY_DATABASE_URI=sqlite:///./app.db

# LLM
GROQ_API_KEY=

# OpenAI - not currently used by the voice LLM
OPENAI_API_KEY=

# LiveKit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional/local service URLs
STT_API_URL=
LLM_API_URL=
TTS_API_URL=
TTS_API_KEY=

# Qdrant
QDRANT_PORT=6333
QDRANT_HOST=

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# Search / scraping
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# Memory
MEM0_API_KEY=

MCP_SEARCH_URL=http://127.0.0.1:7861/sse
MCP_SCRAPER_URL=http://127.0.0.1:7860/sse